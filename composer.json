{
    "name": "happenv-com/laravel-access-control",
    "description": "A modular access control library for Laravel applications.",
    "license": "MIT",
    "keywords": [
        "happenv",
        "laravel",
        "acl",
        "voter",
        "modular",
        "permissions",
        "roles",
        "rbac",
        "access-control"
    ],
    "authors": [
        {
            "name": "Happenv sp. z o.o.",
            "email": "code@happenv.com",
            "homepage": "https://happenv.com",
            "role": "Maintainer"
        },
        {
            "name": "webard",
            "email": "code@webard.me",
            "homepage": "https://github.com/webard",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/happenv-com/laravel-access-control",
    "support": {
        "issues": "https://github.com/happenv-com/laravel-access-control/issues",
        "source": "https://github.com/happenv-com/laravel-access-control",
        "security": "https://github.com/happenv-com/laravel-access-control/security/policy"
    },
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.20 || ^13.0"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.48",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.2",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-type-coverage": "^4.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "rector/rector": "^2.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Happenv\\LaravelAccessControl\\": "src/",
            "Happenv\\LaravelAccessControl\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Happenv\\LaravelAccessControl\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "ergebnis/composer-normalize": true,
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "aliases": {
                "AccessControl": "Happenv\\LaravelAccessControl\\Facades\\AccessControl"
            },
            "providers": [
                "Happenv\\LaravelAccessControl\\AccessControlServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "ci": [
            "@normalize-composer-test",
            "@rector-test",
            "@pint-test",
            "@phpstan",
            "@psr4-test",
            "@test"
        ],
        "cs": [
            "@normalize-composer",
            "@rector",
            "@pint"
        ],
        "normalize-composer": "@composer normalize --ansi",
        "normalize-composer-test": "@composer normalize --dry-run --ansi",
        "phpstan": "phpstan analyse --ansi",
        "pint": "pint",
        "pint-test": "pint --test",
        "psr4-test": "@composer dump-autoload --optimize --strict-psr",
        "rector": "rector process",
        "rector-test": "rector process --dry-run",
        "test": "pest --testsuite=Unit,Feature",
        "test-coverage": "pest --testsuite=Unit,Feature --coverage",
        "test-type-coverage": "pest --type-coverage --exactly=100",
        "type-coverage": "pest --type-coverage"
    }
}
